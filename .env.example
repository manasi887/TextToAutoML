# Optional Compose overrides. Copy to .env before changing these defaults.
# The intent classifier must be trained/saved at INTENT_MODEL_DIR before NLP is ready.
BACKEND_HOST=0.0.0.0
# Host port published for direct API access; the container and Nginx use port 8000.
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
INTENT_MODEL_DIR=./backend/storage/nlp_models/intent_classifier
TARGET_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TARGET_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_CACHE_DIR=./.cache/huggingface

# Used only by the Vite development server; production requests use same-origin Nginx routes.
VITE_API_BASE=http://127.0.0.1:8000
